{
  "name": "bookswap",
  "private": true,
  "version": "1.1.0",
  "workspaces": ["frontend", "backend"],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "seed": "npm run seed --workspace backend",
    "seed:reset": "npm run seed:reset --workspace backend",
    "migrate": "npm run migrate --workspace backend",
    "test": "npm run test --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
