# ---------------------------------------------------------------------------
# BookSwap environment
#
# Copy to .env and adjust. The API works without any of these values in demo
# mode: it then uses the embedded PGlite database in .data/pglite and seeds
# sample listings.
# ---------------------------------------------------------------------------

## Server -------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated browser origins allowed to call the API.
# In production set the exact Vercel/Render URL (no trailing slash), e.g.
# CLIENT_ORIGINS=https://bookswap.vercel.app
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Disable behind a proxy if client IPs are resolved incorrectly.
TRUST_PROXY=false

## Database -----------------------------------------------------------------
# PostgreSQL connection string. When empty the API uses embedded PGlite and
# stores data in .data/pglite (great for local work and demos).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=

# Force TLS on/off regardless of the URL. sslmode=require in DATABASE_URL also
# enables it. Keep unset for a local PostgreSQL without TLS.
# PGSSLMODE=disable

# Optional directory for the embedded database.
# DATA_DIR=.data/pglite

# Seed sample users, listings and reviews when the database is empty.
SEED_DEMO=true

## JWT ----------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=30d

## Staff accounts -----------------------------------------------------------
# Admin and moderator access is issued only for these exact login/password pairs.
# Change them before deploying.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=replace-admin-password
MODERATOR_LOGIN=moderator
MODERATOR_PASSWORD=replace-moderator-password

## Uploads ------------------------------------------------------------------
# Directory for uploaded book covers and avatars.
# UPLOAD_DIR=backend/uploads
MAX_UPLOAD_BYTES=5242880

## SEO ----------------------------------------------------------------------
# Public URL used in canonical links, Open Graph tags, robots.txt and sitemap.
# When omitted, the API derives it from the incoming request host.
# PUBLIC_SITE_URL=https://bookswap.example.com

## Frontend -----------------------------------------------------------------
# Leave empty in development to use the Vite proxy (/api, /uploads).
# VITE_API_URL=https://api.example.com/api
# VITE_PUBLIC_SITE_URL=https://bookswap.example.com
