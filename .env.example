# Server
PORT=4000
# One origin or comma-separated domains allowed to call the API
CLIENT_ORIGINS=http://localhost:5173,https://your-project.vercel.app
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Special staff login. Admin/moderator access is issued only through these pairs.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=replace-admin-password
MODERATOR_LOGIN=moderator
MODERATOR_PASSWORD=replace-moderator-password

# Frontend: leave empty in development to use Vite proxy
# VITE_API_URL=https://api.example.com/api
